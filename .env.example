# Discord Bot Token (obrigatório)
# Pegue em: https://discord.com/developers/applications
DISCORD_TOKEN=seu_token_aqui

# Discord Application ID (obrigatório para comandos slash)
# Pegue em: https://discord.com/developers/applications -> General Information -> Application ID
DISCORD_CLIENT_ID=seu_client_id_aqui

# Discord Guild ID (opcional - para testes rápidos)
# Clique com botão direito no servidor -> Copiar ID (precisa ter modo desenvolvedor ativo)
DISCORD_GUILD_ID=

# Google Gemini API Key (obrigatório para IA)
# Pegue em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=sua_gemini_api_key_aqui

# OpenAI API Key (opcional - para Speech-to-Text com Whisper)
# Pegue em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Cloud Credentials (opcional - alternativa para Speech-to-Text)
# Caminho para o arquivo JSON de credenciais do Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=
